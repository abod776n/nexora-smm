# المنفذ
PORT=3000

# حساب الإدارة الأول (يُنشأ تلقائياً عند أول تشغيل)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# مزوّد الخدمات
TOTA_API_URL=https://bot.tota.click/api/v2
TOTA_API_KEY=your-provider-key

# اجعلها 1 عند النشر على HTTPS
SECURE_COOKIES=0

# بوت المتجر — الدفع بنجوم تيليجرام وربط الحساب
# أنشئه من @BotFather ثم ضع التوكن هنا (لا تشاركه مع أحد)
# اسم المتغيّر STORE_BOT_TOKEN وليس BOT_TOKEN: الأخير يخص بوت المساعد الشخصي
# STORE_BOT_TOKEN=123456:ABC...
# (اختياري) يُقرأ تلقائياً من getMe إذا تركته فارغاً:
# STORE_BOT_USERNAME=your_store_bot

# قاعدة Turso المستضافة (مطلوبة عند النشر على Render — القرص هناك مؤقت)
# اتركها فارغة للتطوير المحلي على ملف data/app.db
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# مسار قاعدة الملف المحلي (اختياري، يُتجاهل عند ضبط Turso)
# DATA_DIR=/var/lib/tota-smm
